# ==========================================================
# 敦煌金质检 LIMS - 生产环境变量示例
# 复制到 .env.prod 并填入真实值,绝不能提交到 git
# 启动前用 ./deploy/env-validate.sh 校验
# ==========================================================

# ---------- 应用版本 ----------
APP_VERSION=1.0.0

# ---------- PostgreSQL ----------
POSTGRES_DB=dunhuang_lims
POSTGRES_USER=dunhuang
POSTGRES_PASSWORD=__SET_ME__            # openssl rand -base64 32
PG_TS_MEMORY=2GB
PG_TS_CPUS=2

# ---------- Redis ----------
REDIS_PASSWORD=__SET_ME__                # openssl rand -base64 32

# ---------- JWT ----------
JWT_SECRET=__SET_ME__                    # openssl rand -base64 64
JWT_REFRESH_SECRET=__SET_ME__            # openssl rand -base64 64

# ---------- TOTP 加密密钥 ----------
# 32 字节随机,AES-256-GCM 加密 TOTP secret 用
# openssl rand -base64 32
TOTP_ENCRYPTION_KEY=__SET_ME__

# ---------- CORS ----------
# 检测中心内网域名,多个用逗号分隔
CORS_ORIGINS=https://lims.dunhuang-lab.local

# ---------- 限流 ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---------- 日志 ----------
LOG_LEVEL=info

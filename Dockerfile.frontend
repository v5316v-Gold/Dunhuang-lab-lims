# =====================================================
# 敦煌金质检 LIMS - 前端生产镜像
# 构建产物 + nginx 静态托管
# =====================================================

# ---------- 构建阶段 ----------
FROM node:22.11.0-bookworm-slim AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY apps/frontend/package.json ./apps/frontend/
COPY packages/compliance-core/package.json ./packages/compliance-core/
COPY packages/config/package.json ./packages/config/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/ui-kit/package.json ./packages/ui-kit/

RUN pnpm install --frozen-lockfile --filter @dunhuang/lims-frontend... --ignore-scripts

COPY apps/frontend ./apps/frontend
COPY packages ./packages

RUN pnpm --filter @dunhuang/lims-frontend run build

# ---------- 运行时阶段 ----------
FROM nginx:1.27.3-alpine AS runtime

LABEL maintainer="Dunhuang-LIMS IT <it@dunhuang-lab.local>" \
      org.opencontainers.image.title="dunhuang-lims-frontend" \
      org.opencontainers.image.description="敦煌金质检 LIMS 前端 (React 18 + Vite 5)" \
      org.opencontainers.image.source="https://github.com/v5316v-Gold/Dunhuang-lab-lims"

# 复制自定义 nginx 配置(由 docker-compose 挂载或 build-arg 注入)
# 这里使用 build-time COPY(只读)
COPY infrastructure/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# 复制构建产物
COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

EXPOSE 80

# nginx 默认 entrypoint 已正确处理信号
CMD ["nginx", "-g", "daemon off;"]

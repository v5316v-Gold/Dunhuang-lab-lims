  BORAX
  SILICA_SAND
  SODIUM_CARBONATE
  NITRIC_ACID
  HYDROCHLORIC_ACID
  AQUA_REGIA
  HYDROFLUORIC_ACID
  PERCHLORIC_ACID
  ICP_CALIBRATION_STD

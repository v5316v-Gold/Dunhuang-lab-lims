model SamplingRecord {
  id                  String           @id @default(uuid()) @db.Uuid
  recordNo            String           @unique @db.VarChar(50)               // 取样单号 SR-2026-0001
  sampleId            String?          @unique @map("sample_id") @db.Uuid    // 关联样品(1-1 可选)
  method              SamplingMethod
  location            SamplingLocation
  locationDetail      String?          @map("location_detail") @db.VarChar(200) // 详细地址
  sampledAt           DateTime         @map("sampled_at") @db.Timestamptz      // 取样时间
  sampledById         String           @map("sampled_by_id") @db.Uuid         // 取样人
  customerRepName     String?          @map("customer_rep_name") @db.VarChar(50) // 客户代表姓名
  customerRepIdNo     String?          @map("customer_rep_id_no") @db.VarChar(20) // 客户代表身份证号
  witnessName         String?          @map("witness_name") @db.VarChar(50)   // 见证人姓名
  witnessIdNo         String?          @map("witness_id_no") @db.VarChar(20)   // 见证人身份证号
  sampleForm          SampleForm       @map("sample_form")                     // 样品形态
  metalType           MetalType        @map("metal_type")                      // 金属种类
  declaredWeightG     Decimal?         @map("declared_weight_g") @db.Decimal(15, 6) // 客户声明重量
  declaredPurityPct   Decimal?         @map("declared_purity_pct") @db.Decimal(10, 6) // 客户声明纯度
  packagingType       String?          @map("packaging_type") @db.VarChar(50) // 包装形式:密封袋/铅封
  sealNo              String?          @map("seal_no") @db.VarChar(50)         // 封条编号
  photoFileIds        String[]         @map("photo_file_ids") @db.Uuid          // 取样现场照片

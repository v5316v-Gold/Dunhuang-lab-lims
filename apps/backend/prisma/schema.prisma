  usages            ContainerUsage[]  @relation("ContainerUsageContainer")

  @@index([code])
  @@index([type])
  @@index([material])
  @@index([status])
  @@index([nextCalDate])
  @@map("containers")
}

model ContainerUsage {
  id                String       @id @default(uuid()) @db.Uuid
  usageNo           String       @unique @map("usage_no") @db.VarChar(50)  // USE-20260815-0001
  containerId       String       @map("container_id") @db.Uuid
  usedById          String       @map("used_by_id") @db.Uuid                // 使用人
  testId            String?      @map("test_id") @db.Uuid                   // 关联检测
  sampleId          String?      @map("sample_id") @db.Uuid                 // 关联样品
  purpose           String?      @db.VarChar(200)                           // 用途:王水消解 / ICP定容
  borrowedAt        DateTime     @default(now()) @map("borrowed_at") @db.Timestamptz
  returnedAt        DateTime?    @map("returned_at") @db.Timestamptz        // null = 还在用

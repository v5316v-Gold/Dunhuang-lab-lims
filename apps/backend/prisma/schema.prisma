  TEST_TUBE @map("test_tube")             // 试管
  CONICAL_FLASK @map("conical_flask")     // 锥形瓶
  CYLINDER @map("cylinder")               // 量筒
  PIPETTE @map("pipette")                 // 移液管
  WEIGHING_BOTTLE @map("weighing_bottle") // 称量瓶
  OTHER @map("other")

  @@map("container_type")
}

enum ContainerMaterial {
  PORCELAIN @map("porcelain")             // 瓷
  PLATINUM @map("platinum")               // 铂
  QUARTZ @map("quartz")                   // 石英
  BOROSILICATE @map("borosilicate")       // 硼硅酸盐玻璃
  PTFE @map("ptfe")                       // 聚四氟乙烯
  STAINLESS_STEEL @map("stainless_steel") // 不锈钢
  POLYETHYLENE @map("polyethylene")       // 聚乙烯
  OTHER @map("other")

  @@map("container_material")
}

enum ContainerStatus {
  IN_STOCK @map("in_stock")               // 在库
  IN_USE @map("in_use")                   // 使用中
  CLEANING @map("cleaning")               // 清洗中
  MAINTENANCE @map("maintenance")         // 维护中
  RETIRED @map("retired")                 // 已退役
  LOST @map("lost")                       // 丢失

  @@map("container_status")
}

model Container {
  id                String            @id @default(uuid()) @db.Uuid
  code              String            @unique @db.VarChar(50)        // 容器编号 CT-2026-0001
  name              String            @db.VarChar(100)               // 名称:30mL 瓷坩埚

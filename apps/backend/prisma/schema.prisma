// ============================================================================
// W3-A P0 硬化:测量不确定度(MU)评定模块(CNAS §7.8)
// 严格按 GUM JCGM 100:2008 5 类分量
// ============================================================================

enum UncertaintyReportStatus {
  DRAFT     @map("draft")        // 起草中
  REVIEWED  @map("reviewed")     // 校核完成
  PUBLISHED @map("published")    // 已发布(Test.uncertainty 同步)
  VOIDED    @map("voided")       // 作废

  @@map("uncertainty_report_status")
}

model UncertaintyReport {
  id                String      @id @default(uuid()) @db.Uuid
  reportNo          String      @unique @db.VarChar(50)               // U-2026-0001
  testId            String      @unique @map("test_id") @db.Uuid
  status            UncertaintyReportStatus @default(DRAFT)

  // 主结果(从 Test 同步)
  measuredValue     Decimal     @map("measured_value") @db.Decimal(15, 6)   // 测得值(纯度/浓度)
  combinedU         Decimal     @map("combined_u") @db.Decimal(15, 9)       // 合成标准不确定度
  expandedU         Decimal     @map("expanded_u") @db.Decimal(15, 9)       // 扩展不确定度 U = k × u_c
  coverageFactor Decimal     @default(2.0) @map("coverage_factor") @db.Decimal(4, 2) // k=2
  coverageProb      Decimal     @default(95.00) @map("coverage_prob") @db.Decimal(5, 2)  // 95%

  // 5 类 GUM 分量(单位:与 measuredValue 一致)
  ucTypeA           Decimal?    @map("uc_type_a") @db.Decimal(15, 9)        // 统计(平行样)
  ucTypeBStd        Decimal?    @map("uc_type_b_std") @db.Decimal(15, 9)     // 标准物质
  ucTypeBEquip      Decimal?    @map("uc_type_b_equip") @db.Decimal(15, 9)   // 仪器校准
  ucTypeBVol        Decimal?    @map("uc_type_b_vol") @db.Decimal(15, 9)     // 容量
  ucTypeBEnv        Decimal?    @map("uc_type_b_env") @db.Decimal(15, 9)     // 环境
  ucTypeBOther      Decimal?    @map("uc_type_b_other") @db.Decimal(15, 9)   // 其他

  // 平行样原始数据(JSONB:数组 [{run:1, value:99.98}, ...])
  parallelRuns      Json?       @map("parallel_runs")

  // 计算方法 / 公式引用
  method            String      @default("GUM_JCGM_100") @db.VarChar(50)    // GUM / 北师大公式
  methodDescription String?     @map("method_description") @db.Text

  // 溯源引用
  referenceMaterialId String?   @map("reference_material_id") @db.Uuid     // 主标准物质
  equipmentIds     String[]    @map("equipment_ids") @db.Uuid               // 涉及仪器
  calibrationIds    String[]    @map("calibration_ids") @db.Uuid             // 校准证书

  // 计算附件(GUM Workbench / Excel 输出)
  calculationFileId String?     @map("calculation_file_id") @db.Uuid

  // 过程审计
  calculatedById    String      @map("calculated_by_id") @db.Uuid             // 计算人(分析员)
  calculatedAt      DateTime    @default(now()) @map("calculated_at") @db.Timestamptz
  reviewedById      String?     @map("reviewed_by_id") @db.Uuid               // 校核人(高级分析员)
  reviewedAt        DateTime?   @map("reviewed_at") @db.Timestamptz
  publishedById     String?     @map("published_by_id") @db.Uuid              // 批准人(QA Manager)
  publishedAt       DateTime?   @map("published_at") @db.Timestamptz

  // 公式审计(冻结后不可改)
  formulaSnapshot   String?     @map("formula_snapshot") @db.Text           // 完整计算公式(发布时)

  remarks           String?     @db.Text
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz

  test              Test        @relation("TestUncertainty", fields: [testId], references: [id], onDelete: Restrict)
  referenceMaterial ReferenceMaterial? @relation("UncertaintyReference", fields: [referenceMaterialId], references: [id])
  calculatedBy      User        @relation("UncertaintyCalculator", fields: [calculatedById], references: [id])
  reviewedBy        User?       @relation("UncertaintyReviewer", fields: [reviewedById], references: [id])
  publishedBy       User?       @relation("UncertaintyPublisher", fields: [publishedById], references: [id])
  calculationFile   FileAttachment? @relation("UncertaintyCalculationFile", fields: [calculationFileId], references: [id])

  @@index([reportNo])
  @@index([testId])
  @@index([status])
  @@index([calculatedAt(sort: Desc)])
  @@map("uncertainty_reports")
  rmUsages          ReferenceMaterialUsage[]  @relation("UncertaintyReportRMUsage")
}




// ============================================================================
// P0-B 标准物质使用台账(每条 ElementResult/QcMeasurement 用了哪个 RM)
// CNAS §7.6 测量溯源: 标准物质证书可逐条溯源到具体检测
// ============================================================================

model ReferenceMaterialUsage {
  id                String   @id @default(uuid()) @db.Uuid
  usageNo           String   @unique @map("usage_no") @db.VarChar(50)  // RMU-2026-0001
  referenceMaterialId String  @map("reference_material_id") @db.Uuid
  lotNo             String   @map("lot_no") @db.VarChar(50)            // 批号:GBW02757-2024-A
  // 关联业务
  testId            String?  @map("test_id") @db.Uuid                  // 关联检测
  qcMeasurementId   String?  @map("qc_measurement_id") @db.Uuid       // 关联质控
  elementResultId   String?  @map("element_result_id") @db.Uuid         // 关联元素结果
  uncertaintyReportId String? @map("uncertainty_report_id") @db.Uuid   // 关联不确定度(P0-A)
  purpose           String   @db.VarChar(50)                            // CALIBRATION / QC_CHECK / VERIFICATION / CONFIRM
  // 使用量
  usedAmount        Decimal  @map("used_amount") @db.Decimal(15, 6)    // g / mL
  remainingAmount   Decimal  @map("remaining_amount") @db.Decimal(15, 6) // 剩余量
  // 记录人
  usedById          String   @map("used_by_id") @db.Uuid                 // 使用人
  usedAt            DateTime @default(now()) @map("used_at") @db.Timestamptz
  // 履历
  recoveryPct       Decimal? @map("recovery_pct") @db.Decimal(5, 2)     // 实际回收率(与标称比)
  certificateFileId String?  @map("certificate_file_id") @db.Uuid       // 当时使用的证书附件
  remarks           String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  referenceMaterial ReferenceMaterial @relation("RMUsage", fields: [referenceMaterialId], references: [id])
  test              Test?             @relation("TestRMUsage", fields: [testId], references: [id])
  qcMeasurement     QcMeasurement?    @relation("QcRMUsage", fields: [qcMeasurementId], references: [id])
  elementResult     ElementResult?    @relation("ElementResultRMUsage", fields: [elementResultId], references: [id])
  uncertaintyReport UncertaintyReport? @relation("UncertaintyReportRMUsage", fields: [uncertaintyReportId], references: [id])
  usedBy            User              @relation("RMUsageUser", fields: [usedById], references: [id])
  certificateFile   FileAttachment?   @relation("RMUsageCertificate", fields: [certificateFileId], references: [id])

  @@index([usageNo])
  @@index([referenceMaterialId])
  @@index([testId])
  @@index([qcMeasurementId])
  @@index([elementResultId])
  @@index([uncertaintyReportId])
  @@index([usedAt(sort: Desc)])
  @@map("reference_material_usages")
}



// ============================================================================
// P0-C OOS / NonConformance(CNAS §7.10 不符合工作)
// 自动从 QcMeasurement.Westgard 失败 / 不合格结果 触发
// ============================================================================

enum NonConformanceType {
  OOS_QC_FAILED       @map("oos_qc_failed")        // OOS:QC 不合格
  OOS_RESULT_FAILED   @map("oos_result_failed")    // OOS:结果不合格
  EQUIPMENT_FAILURE   @map("equipment_failure")    // 设备异常
  METHOD_DEVIATION    @map("method_deviation")     // 方法偏离
  SAMPLE_INTEGRITY    @map("sample_integrity")     // 样品完整性
  CLIENT_COMPLAINT    @map("client_complaint")     // 客户投诉
  INTERNAL_AUDIT      @map("internal_audit")       // 内部审核发现
  OTHER               @map("other")

  @@map("non_conformance_type")
}

enum NonConformanceStatus {
  OPEN        @map("open")        // 已登记
  INVESTIGATING @map("investigating") // 调查中
  CAPA_IN_PROGRESS @map("capa_in_progress") // 整改中
  RESOLVED    @map("resolved")    // 已解决
  CLOSED      @map("closed")      // 已关闭(归档)

  @@map("non_conformance_status")
}

enum NonConformanceSeverity {
  MINOR  @map("minor")    // 轻微
  MAJOR  @map("major")    // 重大
  CRITICAL @map("critical") // 严重

  @@map("non_conformance_severity")
}

model NonConformance {
  id                String      @id @default(uuid()) @db.Uuid
  ncNo              String      @unique @db.VarChar(50)        // NC-2026-0001
  type              NonConformanceType
  severity          NonConformanceSeverity @default(MINOR)
  status            NonConformanceStatus  @default(OPEN)

  // 触发源(可空,任一即可)
  qcMeasurementId   String?     @map("qc_measurement_id") @db.Uuid
  testId            String?     @map("test_id") @db.Uuid
  sampleId          String?     @map("sample_id") @db.Uuid
  equipmentId       String?     @map("equipment_id") @db.Uuid

  // 描述
  title             String      @db.VarChar(200)
  description       String      @db.Text
  rootCause         String?     @map("root_cause") @db.Text       // 根本原因(调查中填)
  immediateAction   String?     @map("immediate_action") @db.Text  // 立即措施

  // 调查与关闭
  reportedById      String      @map("reported_by_id") @db.Uuid    // 上报人
  reportedAt        DateTime    @default(now()) @map("reported_at") @db.Timestamptz
  assignedToId      String?     @map("assigned_to_id") @db.Uuid   // 调查负责人
  investigatedById  String?     @map("investigated_by_id") @db.Uuid
  investigatedAt    DateTime?   @map("investigated_at") @db.Timestamptz
  closedById        String?     @map("closed_by_id") @db.Uuid
  closedAt          DateTime?   @map("closed_at") @db.Timestamptz
  closeRemarks      String?     @map("close_remarks") @db.Text     // 关闭说明

  // CAPA(纠正/预防措施)
  correctiveAction  String?     @map("corrective_action") @db.Text
  preventiveAction  String?     @map("preventive_action") @db.Text
  effectivenessVerification String? @map("effectiveness_verification") @db.Text // 有效性验证

  // 审计
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz

  qcMeasurement     QcMeasurement? @relation("NCQcMeasurement", fields: [qcMeasurementId], references: [id])
  test              Test?          @relation("NCTest", fields: [testId], references: [id])
  sample            Sample?        @relation("NCSample", fields: [sampleId], references: [id])
  equipment         Equipment?     @relation("NCEquipment", fields: [equipmentId], references: [id])
  reportedBy        User           @relation("NCReporter", fields: [reportedById], references: [id])
  assignedTo        User?          @relation("NCAssignee", fields: [assignedToId], references: [id])
  investigatedBy    User?          @relation("NCInvestigator", fields: [investigatedById], references: [id])
  closedBy          User?          @relation("NCCloser", fields: [closedById], references: [id])

  @@index([ncNo])
  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([reportedAt(sort: Desc)])
  @@map("non_conformances")
}



// ============================================================================
// W+2 审批管理(CMA 必查): 内审 / 管评 / 监督 / 盲样考核 / 能力验证(PT)
// ============================================================================

// ---- 内部审核(CMA 必查) ----
model InternalAudit {
  id            String   @id @default(uuid()) @db.Uuid
  auditNo       String   @unique @db.VarChar(50)        // IA-2026-0001
  title         String   @db.VarChar(200)               // 审核主题
  scope         String   @db.Text                       // 审核范围
  auditDate     DateTime @map("audit_date") @db.Timestamptz
  auditorIds    String[] @map("auditor_ids") @db.Uuid   // 内审员
  findings      String?  @db.Text                       // 发现
  ncCount       Int      @default(0) @map("nc_count")   // 不符合项数
  status        String   @default("PLANNED") @db.VarChar(20) // PLANNED/IN_PROGRESS/CLOSED
  reportFileId  String?  @map("report_file_id") @db.Uuid
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  createdBy     User     @relation("IACreator", fields: [createdById], references: [id])
  @@index([auditNo])
  @@index([auditDate])
  @@map("internal_audits")
}

// ---- 管理评审(CMA 必查) ----
model ManagementReview {
  id            String   @id @default(uuid()) @db.Uuid
  reviewNo      String   @unique @db.VarChar(50)        // MR-2026-0001
  title         String   @db.VarChar(200)               // 评审主题
  periodFrom    DateTime @map("period_from") @db.Timestamptz
  periodTo      DateTime @map("period_to") @db.Timestamptz
  reviewDate    DateTime @map("review_date") @db.Timestamptz
  attendees     String[] @db.Uuid                        // 参加人员
  inputs        String?  @db.Text                        // 评审输入
  outputs       String?  @db.Text                        // 评审输出/决议
  decisions     String?  @db.Text                        // 决议事项
  status        String   @default("PLANNED") @db.VarChar(20)
  reportFileId  String?  @map("report_file_id") @db.Uuid
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  createdBy     User     @relation("MRCreator", fields: [createdById], references: [id])
  @@index([reviewNo])
  @@index([reviewDate])
  @@map("management_reviews")
}

// ---- 监督记录(CMA 必查) ----
model SupervisionRecord {
  id            String   @id @default(uuid()) @db.Uuid
  supNo         String   @unique @db.VarChar(50)        // SUP-2026-0001
  supervisorId  String   @map("supervisor_id") @db.Uuid  // 监督员
  superviseeId  String   @map("supervisee_id") @db.Uuid  // 被监督人
  supDate       DateTime @map("sup_date") @db.Timestamptz
  content       String   @db.Text                       // 监督内容
  result        String   @default("PASS") @db.VarChar(20) // PASS/CONCERN/FAIL
  correctiveAction String? @map("corrective_action") @db.Text
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  supervisor    User     @relation("SupSupervisor", fields: [supervisorId], references: [id])
  supervisee    User     @relation("SupSupervisee", fields: [superviseeId], references: [id])
  createdBy     User     @relation("SupCreator", fields: [createdById], references: [id])
  @@index([supNo])
  @@index([supDate])
  @@map("supervision_records")
}

// ---- 盲样考核(CMA 必查) ----
model BlindSample {
  id            String   @id @default(uuid()) @db.Uuid
  blindNo       String   @unique @db.VarChar(50)        // BL-2026-0001
  sampleCode    String   @map("sample_code") @db.VarChar(100) // 盲样编号
  assignedToId  String   @map("assigned_to_id") @db.Uuid      // 被考核人
  trueValue     Decimal  @map("true_value") @db.Decimal(15, 6)  // 真值
  measuredValue Decimal? @map("measured_value") @db.Decimal(15, 6) // 测得值
  deviationPct  Decimal? @map("deviation_pct") @db.Decimal(8, 4)  // 相对偏差
  passed        Boolean?                                         // 考核结果
  assessDate    DateTime? @map("assess_date") @db.Timestamptz
  remarks       String?  @db.Text
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  assignedTo    User     @relation("BlindAssignee", fields: [assignedToId], references: [id])
  createdBy     User     @relation("BlindCreator", fields: [createdById], references: [id])
  @@index([blindNo])
  @@map("blind_samples")
}

// ---- 能力验证 PT(CMA 必查) ----
model ProficiencyTest {
  id            String   @id @default(uuid()) @db.Uuid
  ptNo          String   @unique @db.VarChar(50)        // PT-2026-0001
  organizer      String   @db.VarChar(200)               // 组织方(如 CNAS PT 计划)
  item          String   @db.VarChar(100)                // 项目(如 Au 纯度)
  method        String   @db.VarChar(100)
  zScore        Decimal? @map("z_score") @db.Decimal(8, 4)
  result        String?  @db.VarChar(50)                // SATISFACTORY/QUESTIONABLE/UNSATISFACTORY
  startDate     DateTime @map("start_date") @db.Timestamptz
  endDate       DateTime? @map("end_date") @db.Timestamptz
  reportFileId  String?  @map("report_file_id") @db.Uuid
  remarks       String?  @db.Text
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  createdBy     User     @relation("PTCreator", fields: [createdById], references: [id])
  @@index([ptNo])
  @@map("proficiency_tests")
}



// ============================================================================
// W+2-4 临时授权(CNAS §7.2 人员) — 检测员外出时代班
// ============================================================================

model TemporaryAuthorization {
  id            String    @id @default(uuid()) @db.Uuid
  authNo        String    @unique @db.VarChar(50)          // TA-2026-0001
  grantorId     String    @map("grantor_id") @db.Uuid       // 授权人(主管)
  granteeId     String    @map("grantee_id") @db.Uuid       // 被授权人(代班)
  method        String    @db.VarChar(50)                   // FIRE_ASSAY / ICP_OES / ALL
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz
  effectiveTo   DateTime  @map("effective_to") @db.Timestamptz
  reason        String?   @db.VarChar(200)                  // 代班原因
  status        String    @default("ACTIVE") @db.VarChar(20) // ACTIVE/EXPIRED/REVOKED
  revokedById   String?   @map("revoked_by_id") @db.Uuid
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  grantor       User      @relation("TAGrantor", fields: [grantorId], references: [id])
  grantee       User      @relation("TAGrantee", fields: [granteeId], references: [id])
  revokedBy     User?     @relation("TARevoker", fields: [revokedById], references: [id])

  @@index([authNo])
  @@index([granteeId])
  @@index([effectiveFrom, effectiveTo])
  @@map("temporary_authorizations")
}

// =====================================================
// P0-Fix-1 新增:SOP 执行 / 步骤执行记录
// 详见 apps/backend/src/modules/test/sop/sop.service.ts
// =====================================================

enum SopExecutionStatus {
  IN_PROGRESS  @map("in_progress")
  COMPLETED    @map("completed")
  CANCELLED    @map("cancelled")
  FAILED       @map("failed")

  @@map("sop_execution_status")
}

model SopExecution {
  id           String             @id @default(uuid()) @db.Uuid
  sampleId     String             @map("sample_id") @db.Uuid
  batchId      String             @map("batch_id") @db.Uuid
  sopCode      String             @map("sop_code") @db.VarChar(50)        // FIRE-ASSAY-AU 等
  sopVersion   String             @map("sop_version") @db.VarChar(20)
  operatorId   String             @map("operator_id") @db.Uuid
  currentStep  Int                @default(1) @map("current_step")
  totalSteps   Int                @map("total_steps")
  status       SopExecutionStatus @default(IN_PROGRESS)
  startedAt    DateTime           @default(now()) @map("started_at") @db.Timestamptz
  completedAt  DateTime?          @map("completed_at") @db.Timestamptz
  cancelledAt  DateTime?          @map("cancelled_at") @db.Timestamptz
  cancelReason String?            @map("cancel_reason") @db.Text

  sample       Sample    @relation("SampleSopExecution", fields: [sampleId], references: [id])
  operator     User      @relation("UserSopExecution", fields: [operatorId], references: [id])
  steps        SopStepExecution[]

  @@index([sampleId])
  @@index([batchId])
  @@index([operatorId])
  @@index([sopCode])
  @@index([status])
  @@map("sop_executions")
}

model SopStepExecution {
  id              String    @id @default(uuid()) @db.Uuid
  sopExecutionId  String    @map("sop_execution_id") @db.Uuid
  stepOrder       Int       @map("step_order")
  stepCode        String    @map("step_code") @db.VarChar(50)   // MIXING / FUSING / CUPELLING / ...
  stepName        String    @map("step_name") @db.VarChar(100)
  paramsJson      Json      @map("params_json") @db.JsonB
  operatorId      String    @map("operator_id") @db.Uuid
  completedAt     DateTime  @default(now()) @map("completed_at") @db.Timestamptz

  sopExecution    SopExecution @relation(fields: [sopExecutionId], references: [id], onDelete: Cascade)
  operator        User         @relation("UserSopStepExecution", fields: [operatorId], references: [id])

  @@index([sopExecutionId])
  @@index([stepCode])
  @@map("sop_step_executions")
}


  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz

  container         Container    @relation("ContainerUsageContainer", fields: [containerId], references: [id], onDelete: Restrict)
  usedBy            User         @relation("ContainerUsageUser", fields: [usedById], references: [id])

  material          ContainerMaterial
  capacityMl        Decimal?          @map("capacity_ml") @db.Decimal(10, 2)  // 容量(mL)
  toleranceMl       Decimal?          @map("tolerance_ml") @db.Decimal(10, 4) // 容量允差(A级±0.05等)
  toleranceClass    String?           @map("tolerance_class") @db.VarChar(10)  // A级/B级
  serialNo          String?           @map("serial_no") @db.VarChar(50)         // 厂家出厂编号
  manufacturer      String?           @db.VarChar(100)                          // 厂家:唐山陶瓷/蜀牛玻璃
  purchaseDate      DateTime?         @map("purchase_date") @db.Timestamptz
  purchasePrice     Decimal?          @map("purchase_price") @db.Decimal(10, 2)
  location          String?           @db.VarChar(100)                          // 存放位置:容器柜 B-03
  status            ContainerStatus   @default(IN_STOCK)

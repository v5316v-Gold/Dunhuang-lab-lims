  AG @map("ag")           // 银
  PT @map("pt")           // 铂
  PD @map("pd")           // 钯
  RH @map("rh")           // 铑
  IR @map("ir")           // 铱
  OS @map("os")           // 锇
  RU @map("ru")           // 钌

  @@map("metal_type")

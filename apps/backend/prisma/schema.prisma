enum FileCategory {
  REPORT_PDF
  CERTIFICATE
  QC_DATA
  SAMPLE_PHOTO
  TRAINING_CERT
  METHOD_VALIDATION
  EMERGENCY_PLAN
  OTHER
}

model FileAttachment {
  id            String       @id @default(uuid()) @db.Uuid

{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    ".env"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "MINIO_ENDPOINT",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY",
    "RABBITMQ_URL",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "TOTP_ISSUER",
    "CA_API_KEY",
    "TSA_URL",
    "VITE_API_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:e2e": {
      "cache": false,
      "outputs": []
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": [
        "coverage/**"
      ]
    },
    "clean": {
      "cache": false,
      "outputs": []
    }
  }
}
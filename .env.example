# ==========================================================
# 敦煌金质检 LIMS - 环境变量示例
# 复制为 .env 并填入实际值; .env 加入 .gitignore
# ==========================================================

# ----- 应用 -----
NODE_ENV=development
APP_NAME=dunhuang-lims
APP_PORT=3000
APP_VERSION=1.0.0
LOG_LEVEL=debug

# ----- 数据库 (PostgreSQL 16 + TimescaleDB) -----
# 格式: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://dunhuang:dunhuang_dev_pwd@localhost:5432/dunhuang_lims?schema=public
DATABASE_LOGGING=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ----- Redis (缓存/会话/MFA) -----
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_KEY_PREFIX=dunhuang:lims:

# ----- MinIO (S3 兼容对象存储) -----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=dunhuang_minio
MINIO_SECRET_KEY=dunhuang_minio_dev_pwd
MINIO_BUCKET_REPORTS=dunhuang-reports
MINIO_BUCKET_CERTIFICATES=dunhuang-certificates
MINIO_BUCKET_PHOTOS=dunhuang-photos
MINIO_BUCKET_QC=dunhuang-qc-data
MINIO_PUBLIC_URL=http://localhost:9000

# ----- RabbitMQ (异步队列) -----
RABBITMQ_URL=amqp://dunhuang:dunhuang_mq_pwd@localhost:5672
RABBITMQ_PREFETCH=10

# ----- JWT 认证 -----
# 生产环境必须使用 openssl rand -base64 64 生成
JWT_SECRET=dev-jwt-secret-change-me-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ----- TOTP MFA -----
TOTP_ISSUER=敦煌金质检
TOTP_WINDOW=1
TOTP_BACKUP_CODES_COUNT=10
TOTP_ENCRYPTION_KEY=dev-totp-encryption-key-change-me-32chars

# ----- CA 证书(第三方签名服务) -----
# Phase 4 集成;Phase 1 先留 mock
CA_PROVIDER=mock  # mock | junzisign | fadada | sheca
CA_API_URL=
CA_API_KEY=
CA_API_SECRET=

# ----- RFC 3161 时间戳服务 -----
TSA_URL=
TSA_USERNAME=
TSA_PASSWORD=

# ----- CORS -----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# ----- Rate Limiting -----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ----- 上传限制 -----
UPLOAD_MAX_SIZE_MB=50

# ----- 监控 -----
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=dunhuang-lims-backend

# ----- 前端 -----
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_NAME=敦煌金质检 LIMS
VITE_APP_VERSION=1.0.0

# ----- 测试 -----
TEST_DATABASE_URL=postgresql://dunhuang:dunhuang_dev_pwd@localhost:5432/dunhuang_lims_test?schema=public
TEST_REDIS_URL=redis://localhost:6379/1
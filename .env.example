# ============================================================
# LIMS - Environment variables template
# Copy this file to .env and fill in your values
# .env is gitignored, .env.example is NOT
# ============================================================

# ===== Server =====
# Listening port
PORT=3000

# 'development' | 'production' | 'test'
NODE_ENV=development

# ===== Session Secret =====
# MUST be set in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Min length: 32 chars
SESSION_SECRET=please-generate-with-openssl-rand-base64-32

# ===== Database =====
# Path to the SQLite data file
DB_DATA_PATH=D:\lims_data\lims_cnas.data

# ===== Uploads =====
# Directory for uploaded PDF reports
UPLOAD_DIR=D:\lims_uploads

# ===== Session Cookie (optional) =====
# Cookie max-age in milliseconds (default: 24h)
# COOKIE_MAX_AGE_MS=86400000

# ===== Logging =====
# LOG_LEVEL=info
